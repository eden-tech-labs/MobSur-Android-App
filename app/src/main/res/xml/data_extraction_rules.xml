<?xml version="1.0" encoding="utf-8"?>
<!--
   Backup rules for Android 12+. The MobSur SDK state and the demo's test user ID are not
   backed up or transferred, so a reinstall starts with a fresh user.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="MobSur.xml" />
        <exclude domain="sharedpref" path="demo.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="MobSur.xml" />
        <exclude domain="sharedpref" path="demo.xml" />
    </device-transfer>
</data-extraction-rules>
