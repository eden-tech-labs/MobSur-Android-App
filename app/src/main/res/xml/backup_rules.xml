<?xml version="1.0" encoding="utf-8"?>
<!--
   Backup rules for Android 11 and lower. See data_extraction_rules.xml for Android 12+.
   The MobSur SDK state and the demo's test user ID are not backed up, so a reinstall starts
   with a fresh user and every survey can be tested again.
-->
<full-backup-content>
    <exclude domain="sharedpref" path="MobSur.xml" />
    <exclude domain="sharedpref" path="demo.xml" />
</full-backup-content>
